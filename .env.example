# Copy to .env and fill in what you have. Every key is optional:
# with no keys at all, `npm run demo` still renders complete offline demos.
# Keys are read on the server only and never sent to the browser.
# Note: a Claude subscription does not include Anthropic API usage; the API is billed separately.

# --- Script, creative direction, storyboard (required for arbitrary prompts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

# --- Narration + sound effects
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- AI images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low | medium | high
OPENAI_IMAGE_QUALITY=medium

# --- Licensed stock media (optional)
PEXELS_API_KEY=

# --- AI video clips (optional, can be expensive)
VIDEO_PROVIDER=fal
VIDEO_PROVIDER_API_KEY=
VIDEO_MODEL=kling/v4/image-to-video
VIDEO_CLIP_SECONDS=5
VIDEO_RESOLUTION=720p

# --- Spending guard: operations whose estimate exceeds this need explicit approval
MAX_GENERATION_BUDGET_USD=5

# --- Price assumptions used for estimates (USD); adjust to your plans
PRICE_LLM_INPUT_PER_MTOK=4
PRICE_LLM_OUTPUT_PER_MTOK=20
PRICE_IMAGE_LOW=0.02
PRICE_IMAGE_MEDIUM=0.06
PRICE_IMAGE_HIGH=0.2
PRICE_VIDEO_PER_SECOND=0.1
PRICE_TTS_PER_1K_CHARS=0.2
PRICE_SFX_PER_SECOND=0.01

# --- Rendering (optional)
# Path to a Chrome Headless Shell if Remotion cannot download one
REMOTION_BROWSER_EXECUTABLE=
RENDER_CONCURRENCY=
