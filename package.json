    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@remotion/bundler": "^4.0.541",
    "@remotion/captions": "^4.0.541",
    "@remotion/cli": "^4.0.541",
    "@remotion/fonts": "^4.0.541",
    "@remotion/layout-utils": "^4.0.541",
    "@remotion/media": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "@remotion/noise": "^4.0.541",
    "@remotion/paths": "^4.0.541",
    "@remotion/renderer": "^4.0.541",
    "@remotion/shapes": "^4.0.541",
    "@remotion/transitions": "^4.0.541",
    "@remotion/zod-types": "^4.0.541",
    "commander": "^15.0.0",
