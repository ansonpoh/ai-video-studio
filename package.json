{
  "name": "ai-video-studio",
  "version": "0.1.0",
  "description": "Local-first short-form video generation studio: prompt to storyboard to rendered, editable Remotion project.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "studio": "tsx src/cli/index.ts sync-studio && remotion studio src/video/index.ts",
    "demo": "tsx src/cli/index.ts demo",
    "make": "tsx src/cli/index.ts make",
    "render:video": "tsx src/cli/index.ts render",
    "regen": "tsx src/cli/index.ts regenerate",
    "export": "tsx src/cli/index.ts export",
    "status": "tsx src/cli/index.ts status",
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@elevenlabs/elevenlabs-js": "^2.76.0",
    "@fal-ai/client": "^1.10.1",
