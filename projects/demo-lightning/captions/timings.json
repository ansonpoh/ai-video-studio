  "cues": [
    {
      "startMs": 300,
      "endMs": 3240,
      "text": "Lightning is about five times hotter than"
    },
    {
      "startMs": 3260,
      "endMs": 4858,
      "text": "the surface of the Sun."
    },
    {
      "startMs": 5333,
      "endMs": 7658,
      "text": "Inside a storm cloud, ice crystals and"
    },
    {
      "startMs": 7678,
      "endMs": 10070,
      "text": "soft hail collide, separating electric"
    },
    {
      "startMs": 10090,
      "endMs": 10790,
      "text": "charge."
    },
    {
      "startMs": 11000,
      "endMs": 13654,
      "text": "When the imbalance grows, a faint stepped"
    },
    {
      "startMs": 13674,
      "endMs": 15635,
      "text": "leader zigzags toward the ground."
    },
    {
      "startMs": 16167,
      "endMs": 19323,
      "text": "It meets a streamer rising up, and a huge"
    },
    {
      "startMs": 19343,
      "endMs": 21956,
      "text": "current flashes back up the channel."
    },
    {
      "startMs": 22467,
      "endMs": 24705,
      "text": "That heats the air to around thirty"
    },
    {
      "startMs": 24725,
      "endMs": 25829,
      "text": "thousand kelvin."
    },
    {
      "startMs": 26333,
      "endMs": 27926,
      "text": "The air explodes outward."
    },
    {
      "startMs": 28146,
      "endMs": 29815,
      "text": "That shock wave is thunder."
    },
    {
      "startMs": 30333,
      "endMs": 33002,
      "text": "Count from flash to thunder: every three"
    },
    {
      "startMs": 33022,
      "endMs": 34968,
      "text": "seconds is about one kilometre."
    }
  ],
