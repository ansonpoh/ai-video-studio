  "cues": [
    {
      "startMs": 300,
      "endMs": 3324,
      "text": "Three tiny habits for a far more focused"
    },
    {
      "startMs": 3344,
      "endMs": 3980,
      "text": "day."
    },
    {
      "startMs": 4000,
      "endMs": 5887,
      "text": "One: plan tomorrow tonight."
    },
    {
      "startMs": 6107,
      "endMs": 8433,
      "text": "Pick your top three tasks before bed."
    },
    {
      "startMs": 8733,
      "endMs": 11770,
      "text": "Two: work in focus sprints, twenty five to"
    },
    {
      "startMs": 11790,
      "endMs": 13636,
      "text": "fifty minutes, then rest."
    },
    {
      "startMs": 13967,
      "endMs": 17125,
      "text": "Three: silence your phone and put it out"
    },
    {
      "startMs": 17145,
      "endMs": 17845,
      "text": "of reach."
    },
    {
      "startMs": 18200,
      "endMs": 21220,
      "text": "Stack all three, and your best hours go"
    },
    {
      "startMs": 21240,
      "endMs": 22451,
      "text": "to what matters."
    },
    {
      "startMs": 22800,
      "endMs": 25392,
      "text": "Save this and try one habit tomorrow."
    }
  ],
