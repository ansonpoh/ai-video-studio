  "cues": [
    {
      "startMs": 300,
      "endMs": 3193,
      "text": "Imagine looking up one night and seeing"
    },
    {
      "startMs": 3213,
      "endMs": 4970,
      "text": "not one moon, but two."
    },
    {
      "startMs": 5700,
      "endMs": 8087,
      "text": "In this thought experiment, a smaller"
    },
    {
      "startMs": 8107,
      "endMs": 10002,
      "text": "second moon circles beside ours."
    },
    {
      "startMs": 10700,
      "endMs": 12996,
      "text": "Pulled from two directions, the oceans"
    },
    {
      "startMs": 13016,
      "endMs": 15511,
      "text": "could swell into higher, less predictable"
    },
    {
      "startMs": 15531,
      "endMs": 16231,
      "text": "tides."
    },
    {
      "startMs": 16600,
      "endMs": 19222,
      "text": "Coastlines would reshape, and shore life"
    },
    {
      "startMs": 19242,
      "endMs": 21235,
      "text": "would adapt to a restless rhythm."
    },
    {
      "startMs": 22000,
      "endMs": 24130,
      "text": "But two moons rarely stay in harmony."
    },
    {
      "startMs": 24350,
      "endMs": 26964,
      "text": "Their gravity could slowly unbalance their"
    },
    {
      "startMs": 26984,
      "endMs": 27684,
      "text": "orbits."
    },
    {
      "startMs": 28166,
      "endMs": 31127,
      "text": "One might collide with the other, or be"
    },
    {
      "startMs": 31147,
      "endMs": 32417,
      "text": "flung into space."
    },
    {
      "startMs": 33167,
      "endMs": 35959,
      "text": "Only a what if, but it shows how"
    },
    {
      "startMs": 35979,
      "endMs": 38572,
      "text": "much one Moon shapes our world."
    }
